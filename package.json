{
  "name": "viral-post-research-tool",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Single-user, fully-local research tool for finding viral social posts (LinkedIn + Twitter/X).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "start:agent": "NEXT_DIST_DIR=.next-agent READONLY_SERVER=1 next start -H 127.0.0.1 -p 3100",
    "start:snapshot": "NEXT_DIST_DIR=.next-agent DB_PATH=./snapshot.db READONLY_SERVER=1 next start -H 127.0.0.1 -p 3100",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:3100",
    "api:token": "node scripts/api-token.mjs",
    "snapshot": "node scripts/export-snapshot.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:agent": "NEXT_DIST_DIR=.next-agent next build",
    "stop:agent": "pkill -f 'next-server|next start' || true",
    "followers:snapshot": "node scripts/snapshot-followers.mjs",
    "creators:prune": "node scripts/prune-creators.mjs",
    "scan:viral": "tsx scripts/scrape-viral-window.ts",
    "xfactor:backfill": "tsx scripts/recompute-xfactor.ts",
    "post-loop:daily": "tsx scripts/daily-post-performance.ts",
    "posts:refresh": "node scripts/refresh-engagement.mjs"
  },
  "dependencies": {
    "apify-client": "^2.9.3",
    "better-sqlite3": "^11.1.2",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "jsdom": "^24.1.3",
    "msw": "^2.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
