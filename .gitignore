# dependencies
/node_modules

# next.js
/.next
/out

# production
/build

# local SQLite database (holds the user's BYO keys + scraped data) — NEVER commit
*.db
*.db-journal
*.db-wal
*.db-shm
research.db
# ...including pre-migration backups: `*.db` does not match a `.bak` suffix, and research.db.pre-fts.bak
# is 669MB — well past GitHub's 100MB file limit, so committing it does not just leak data, it breaks
# the push.
*.db.bak
*.db.*.bak
research.db.pre-fts.bak

# env — only DB_PATH lives here, but never commit it
.env
.env.local
.env*.local

# local media cache — downloaded post images (large, user-local data, not source)
/public/post-images/

# test / coverage
/coverage

# misc
.DS_Store
*.tsbuildinfo
next-env.d.ts
npm-debug.log*

# Deployable corpus snapshot (§20.5) — rebuilt with `npm run snapshot`, never committed
snapshot.db
snapshot.db-wal
snapshot.db-shm

# Agent server build output (separate from .next so `next dev` cannot clobber it)
.next-agent
